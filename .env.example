# Copy to .env and edit. .env is git-ignored and must never be committed.

LEADMIND_ENVIRONMENT=local
LEADMIND_LOG_LEVEL=INFO
LEADMIND_LOG_JSON=false

# Postgres 16 + pgvector. `docker compose up -d db` provides this locally.
LEADMIND_DATABASE_URL=postgresql+psycopg://leadmind:leadmind@127.0.0.1:5432/leadmind
LEADMIND_DB_ECHO=false

# Deduplication: rapidfuzz token_set_ratio floor for queueing a duplicate candidate.
# Tuned in backend/tests/unit/test_dedup_threshold.py against the 168 known duplicate pairs.
LEADMIND_FUZZY_NAME_THRESHOLD=92
